{
  "manifest_version": 3,
  "name": "LinkDeck",
  "version": "1.0.0",
  "description": "A minimalist personal dashboard for your links.",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "favicon.svg",
      "48": "favicon.svg",
      "128": "favicon.svg"
    }
  },
  "icons": {
    "16": "favicon.svg",
    "48": "favicon.svg",
    "128": "favicon.svg"
  },
  "permissions": ["storage"]
}
